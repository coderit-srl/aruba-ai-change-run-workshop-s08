# Copiare in .env e sostituire DOMINIO con il dominio comunicato in aula.
# Nessun valore qui e' segreto: il sandbox NovaDC contiene solo dati sintetici.
#
# Le skill leggono questi URL dall'ambiente, quindi vanno esportati nella shell prima di
# avviare l'harness:
#
#   set -a; . ./.env; set +a
#   claude            # oppure opencode, codex, copilot
#
# Log e metriche arrivano in S03: le loro variabili si aggiungono allora.

WIKI_URL=https://novadc-wiki.DOMINIO
TICKETS_URL=https://novadc-tickets.DOMINIO

# Server MCP condiviso del docente, dal Blocco D. Nel LAB 4.2 si passa alla copia locale:
#   MCP_URL=http://localhost:8083
MCP_URL=https://novadc-mcp.DOMINIO
